# Supabase Configuration
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_OR_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend Email Service
RESEND_API_KEY=your-resend-api-key

# Application Settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000/
# Pour développement: "developpement" | Pour production: "production"
NEXT_PUBLIC_NODE_ENV=developpement

# AI Content Generation (Optional)
ANTHROPIC_API_KEY=your-anthropic-api-key
CONTENT_GENERATION_API_KEY=your-content-generation-key

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ====================================
# STRIPE CONFIGURATION
# ====================================

# DÉVELOPPEMENT/TEST
# Utilisez les clés de test Stripe pour le développement
# Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PRODUCTION
# Pour la production, remplacez par vos clés live Stripe
# Dashboard: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_live_...
# NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ====================================
# NOTES IMPORTANTES POUR STRIPE
# ====================================
# 
# 1. Les price IDs sont configurés dans lib/stripe-config.ts
#    - Les price IDs de TEST sont déjà configurés
#    - Les price IDs de PRODUCTION doivent être ajoutés manuellement
#
# 2. Pour configurer les webhooks Stripe:
#    - Dev: stripe listen --forward-to localhost:3000/api/webhooks/stripe
#    - Prod: Configurez l'endpoint dans le dashboard Stripe
#
# 3. L'environnement (test/live) est automatiquement détecté selon:
#    - NEXT_PUBLIC_NODE_ENV === 'developpement' -> Mode TEST
#    - NEXT_PUBLIC_NODE_ENV === 'production' -> Mode LIVE
#
# 4. Pour passer en production:
#    a. Créez vos produits et prix dans le dashboard Stripe Live
#    b. Mettez à jour STRIPE_PRICE_IDS_PROD dans lib/stripe-config.ts
#    c. Changez NEXT_PUBLIC_NODE_ENV en "production"
#    d. Utilisez les clés API live de Stripe